<!-- res/values/styles.xml -->
<resources>

    <!-- Calculator Button Styles -->
    <style name="CalcDarkButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">#333333</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="CalcGrayButton" parent="CalcDarkButton">
        <item name="android:background">#A5A5A5</item>
        <item name="android:textColor">#000000</item>
    </style>

    <style name="CalcOrangeButton" parent="CalcDarkButton">
        <item name="android:background">#FF9500</item>
    </style>

</resources>